#!/data/data/com.termux/files/usr/bin/bash
# Foreground Termux session opened at boot by /system/bin/termux-intro.sh:
#  1. "types" and runs a few everyday commands
#  2. links to the Claude / Gemini / OpenAI API endpoints (real DNS+TCP+TLS
#     checks, no API keys; a 401/403 reply still proves the endpoint is up)
#  3. prints a live status board, then leaves an interactive shell

case $(getprop ro.product.device) in taimen) HOSTNAME_=pixel ;; *) HOSTNAME_=redmi ;; esac
PROMPT=$'\033[1;32m'"laohan@$HOSTNAME_"$'\033[0m:\033[1;34m~\033[0m$ '
G=$'\033[1;32m' R=$'\033[1;31m' Y=$'\033[1;33m' C=$'\033[1;36m' D=$'\033[2m' W=$'\033[1;37m' N=$'\033[0m'
FAILS=0

type_out() { local s=$1 i; for ((i = 0; i < ${#s}; i++)); do printf '%s%s%s' "$W" "${s:i:1}" "$N"; sleep 0.025; done; }

run() {  # type the command out character by character, then execute it
  printf '%s' "$PROMPT"; type_out "$1"; printf '\n'; sleep 0.2
  eval "$1"
  printf '\n'; sleep "${2:-0.8}"
}

ms() { awk -v s="$1" 'BEGIN{printf "%.0f", s*1000}'; }

link() {  # name host url : spinner while a real HTTPS handshake runs
  local name=$1 host=$2 url=$3 f=0 spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' code dns tcp tls ip
  local tmp=$PREFIX/tmp/link.$$
  curl -s -o /dev/null -m 8 -w '%{http_code} %{time_namelookup} %{time_connect} %{time_appconnect} %{remote_ip}' \
    "$url" > "$tmp" 2>/dev/null &
  local pid=$!
  while kill -0 $pid 2>/dev/null || ((f < 12)); do  # spin at least ~0.7s for effect
    printf '\r  %s%s%s  %-7s %s%s%s' "$C" "${spin:f%10:1}" "$N" "$name" "$D" "$host" "$N"
    sleep 0.06; ((f++))
  done
  wait $pid; read -r code dns tcp tls ip < "$tmp"; rm -f "$tmp"
  if [[ $code =~ ^[1-5][0-9][0-9]$ ]]; then
    printf '\r  %s✔%s  %-7s %s%s%s\n' "$G" "$N" "$name" "$D" "$host" "$N"
    printf '     %sdns %sms · tcp %sms · tls %sms%s\n' "$D" "$(ms $dns)" "$(ms $tcp)" "$(ms $tls)" "$N"
    LINKS_OK=$((LINKS_OK + 1))
  else
    printf '\r  %s✖%s  %-7s %s%s%s  %s不可达%s\n' "$R" "$N" "$name" "$D" "$host" "$N" "$R" "$N"
  fi
  sleep 0.3
}

row() {  # label detail healthy(0/1) [bad-text]
  local st
  if [ "$3" = 1 ]; then st="$G● 正常$N"; else st="$R● ${4:-异常}$N"; FAILS=$((FAILS + 1)); fi
  printf '  %s  %-20s %s\n' "$1" "$2" "$st"
}

clear
run "neofetch" 1.2
run "uptime"
run "ping -c 3 223.5.5.5"
# wait (silently, max 40s) until the root service has published Wi-Fi details
for _ in $(seq 1 40); do jq -e '.wifi.ssid != ""' ~/.phonestat.json >/dev/null 2>&1 && break; sleep 1; done
run "df -h /data"
run "free -h" 0.5

printf '%s' "$PROMPT"; type_out "ai-link --all"; printf '\n\n'; sleep 0.3
printf '  %s建立 AI 服务链路 …%s\n\n' "$Y" "$N"
LINKS_OK=0
link Claude api.anthropic.com https://api.anthropic.com/v1/models
link Gemini generativelanguage.googleapis.com https://generativelanguage.googleapis.com/v1beta/models
link OpenAI api.openai.com https://api.openai.com/v1/models
printf '\n  %s%d/3 链路已建立%s\n\n' "$([ $LINKS_OK -eq 3 ] && echo "$G" || echo "$Y")" "$LINKS_OK" "$N"
sleep 0.8

# ---- live status board (every value read now, nothing hard-coded)
s=$(curl -s -m 5 localhost:8080/api/status)
j() { jq -r "$1 // empty" <<<"$s" 2>/dev/null; }
bat=$(j .battery.level | cut -d. -f1); bst=$(j .battery.status)
lo=$(j .root.charge_ctl.low); hi=$(j .root.charge_ctl.high); age=$(j .root.age_s)
ssid=$(j .root.wifi.ssid); rssi=$(j .root.wifi.rssi); ip=$(j .root.wifi.ip | cut -d/ -f1)
temp=$(j .temps.CPU); upm=$(( $(j .uptime_s || echo 0) / 60 ))
up=$([ $upm -ge 60 ] && echo "$((upm / 60)) 小时 $((upm % 60)) 分钟" || echo "$upm 分钟")

printf '%s' "$PROMPT"; type_out "status"; printf '\n\n'; sleep 0.3
printf '  %s━━━━━━━━━━━━ 服务器状态 ━━━━━━━━━━━━%s\n' "$C" "$N"
# probe the port instead of pgrep: on the Pixel sshd runs in Magisk's SELinux domain,
# which the Termux app (untrusted_app) is not allowed to see in /proc
port_open() { timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null; }
row "SSH     " ":8022"                     "$(port_open 8022 && echo 1)" "未运行"
row "网页面板" ":8080"                     "$([ -n "$s" ] && echo 1)" "未响应"
row "充电控制" "${lo:-?}-${hi:-?}%"        "$([ "${age:-999}" -lt 60 ] && echo 1)" "未运行"
row "Wi-Fi   " "${ssid:-未连接} ${rssi:+${rssi}dBm}" "$([ -n "$ssid" ] && echo 1)" "未连接"
row "电池    " "${bat:-?}% ${bst}"         "$([ "${bat:-0}" -ge 20 ] && echo 1)" "电量低"
row "CPU温度 " "${temp:-?} C"              "$(awk -v t="${temp:-99}" 'BEGIN{if (t < 70) print 1}')" "过热"
row "AI链路  " "${LINKS_OK}/3"             "$([ $LINKS_OK -eq 3 ] && echo 1)" "部分不可达"
printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n\n' "$C" "$N"
if [ $FAILS -eq 0 ]; then
  printf '  %s▶ ALL SYSTEMS NORMAL%s\n' "$G" "$N"
else
  printf '  %s▶ %d 项异常，请检查%s\n' "$R" "$FAILS" "$N"
fi
printf '  %s%s · 已运行 %s%s\n\n  %s青岛老汉的小服务器%s\n\n' "$D" "${ip:-?}" "${up:-?}" "$N" "$W" "$N"

PS1="$PROMPT" exec bash --norc -i
